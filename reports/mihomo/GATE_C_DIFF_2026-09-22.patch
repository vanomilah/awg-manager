+// ProxyObservation is the read-only observed state of an NDMS Proxy interface.
+type ProxyObservation struct {
+	Name        string
+	Exists      bool
+	Description string
+	State       string
+	Link        string
+	Up          bool
+	SystemName  string
+	Address     string
+	ListenPort  int
