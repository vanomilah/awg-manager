+var secretRegexes = []*regexp.Regexp{
+	regexp.MustCompile(`(?i)(["']?(?:password|secret|token|private[-_]?key|uuid|auth[-_]?key)["']?\s*[:=]\s*["'])([^"'\r\n]+)(["'])`),
