+func containsStr(s, sub string) bool {
+	return len(s) >= len(sub) && (s == sub || stringContains(s, sub))
+}
+
+func stringContains(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
