+				Secret      string `yaml:"secret"`
+			}
+			if err := yaml.Unmarshal(data, &probe); err == nil {
+				if probe.ExternalCtl != "" {
+					addr = probe.ExternalCtl
+				}
+				if secret == "" && probe.Secret != "" {
+					secret = probe.Secret
+				}
+			}
+		}
+	}
+
+	if addr == "" {
+		addr = "127.0.0.1:9090"
+	}
+
+	h, pStr, err := net.SplitHostPort(addr)
+	if err != nil {
+		host = "127.0.0.1"
+		port = 9090
+	} else {
+		p, _ := strconv.Atoi(pStr)
+		if p <= 0 {
