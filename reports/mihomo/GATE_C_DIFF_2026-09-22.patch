+func (r *mihomoBridgeRuntime) resolvePublishIdentity(ref mihomo.BridgeRef) (canonicalOwner string, legacyOwners []string, listenPort int, err error) {
+	if err := ref.ValidateCompleteForPublish(); err != nil {
