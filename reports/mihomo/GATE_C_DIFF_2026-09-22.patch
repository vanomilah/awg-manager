+		}
+		return nil
+	}
+
+	if obs.LegacyOwner != "" {
+		isLegacyAllowed := (obs.LegacyOwner == "awg-manager" || obs.LegacyOwner == "awgm")
+		if ref.LegacyOwner != "" && obs.LegacyOwner == ref.LegacyOwner {
