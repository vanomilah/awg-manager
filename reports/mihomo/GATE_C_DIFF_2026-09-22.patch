+			ProxyInterface:  nb.Bridge.ProxyInterface,
+			KernelInterface: nb.Bridge.KernelInterface,
+			ListenPort:      nb.Bridge.ListenPort,
+			OwnerUUID:       storeOwner,
+			LegacyOwner:     nb.LegacyOwner,
