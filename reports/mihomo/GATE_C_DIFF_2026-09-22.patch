+// RedactSecrets replaces sensitive credentials, tokens, and passwords in a string with [REDACTED].
+func RedactSecrets(s string) string {
+	for _, re := range secretRegexes {
+		if strings.Contains(re.String(), "Bearer") {
+			s = re.ReplaceAllString(s, "${1}[REDACTED]")
+		} else if strings.Contains(re.String(), "https?") {
+			s = re.ReplaceAllString(s, "${1}[REDACTED]${3}")
+		} else {
+			s = re.ReplaceAllString(s, "${1}[REDACTED]${3}")
+		}
+	}
+	return s
+}
