+func resolveProxyIndex(ref mihomo.BridgeRef) int {
+	if ref.ProxyIndex > 0 {
+		return ref.ProxyIndex
+	}
+	if strings.HasPrefix(ref.ProxyInterface, "Proxy") {
+		var idx int
+		if _, err := fmt.Sscanf(ref.ProxyInterface, "Proxy%d", &idx); err == nil {
+			return idx
+		}
+	}
+	if strings.HasPrefix(ref.KernelInterface, "t2s") {
+		var idx int
+		if _, err := fmt.Sscanf(ref.KernelInterface, "t2s%d", &idx); err == nil {
+			return idx
+		}
+	}
+	return ref.ProxyIndex
+}
+
+func isAllowedLegacyOwner(desc string, legacyOwners []string) bool {
+	for _, leg := range legacyOwners {
+		if leg != "" && desc == leg {
+			return true
+		}
+	}
+	return false
+}
+
+// resolveOwnedBridge searches the native store for a unique bridge matching ref.
+// Zero defaults: if the bridge cannot be uniquely matched, it fails closed with typed error.
+func (r *mihomoBridgeRuntime) resolveOwnedBridge(ref mihomo.BridgeRef) (canonicalOwner string, legacyOwners []string, listenPort int, err error) {
+	if r == nil || r.store == nil {
+		return "", nil, 0, fmt.Errorf("%w: runtime or native store is nil", mihomo.ErrForeignBridgeOwnership)
+	}
+	proxyIdx := resolveProxyIndex(ref)
+	nativeBridges := r.store.ListBridges()
+	var matched []mihomonative.BridgeRef
+	for _, nb := range nativeBridges {
+		if nb.Bridge.ProxyIndex != proxyIdx {
+			continue
+		}
+		if ref.ProxyInterface != "" && nb.Bridge.ProxyInterface != ref.ProxyInterface {
+			continue
+		}
+		if ref.KernelInterface != "" && nb.Bridge.KernelInterface != ref.KernelInterface {
+			continue
+		}
+		matched = append(matched, nb)
+	}
+	if len(matched) == 0 {
+		return "", nil, 0, fmt.Errorf("%w: bridge Proxy%d not found in native store", mihomo.ErrForeignBridgeOwnership, proxyIdx)
+	}
+	if len(matched) > 1 {
+		return "", nil, 0, fmt.Errorf("%w: ambiguous native store bridges for Proxy%d (%d matches)", mihomo.ErrForeignBridgeOwnership, proxyIdx, len(matched))
+	}
+	nb := matched[0]
+	canonicalOwner = mihomonative.BridgeOwnershipDescription(nb.Kind, nb.ID)
+	listenPort = nb.Bridge.ListenPort
+
+	legacyOwners = append([]string{}, globalBridgeLegacyOwners...)
+	if nb.LegacyOwner != "" && nb.LegacyOwner != canonicalOwner {
+		found := false
+		for _, glo := range globalBridgeLegacyOwners {
+			if glo == nb.LegacyOwner {
+				found = true
+				break
+			}
+		}
+		if !found {
+			legacyOwners = append(legacyOwners, nb.LegacyOwner)
+		}
+	}
+	return canonicalOwner, legacyOwners, listenPort, nil
+}
+
+// InspectBridge inspects the live NDMS state of a bridge interface, classifying its ownership
+// mutually exclusively against the native store identity.
+func (r *mihomoBridgeRuntime) InspectBridge(ctx context.Context, ref mihomo.BridgeRef) (mihomo.ObservedBridge, error) {
+	canonicalOwner, legacyOwners, _, err := r.resolveOwnedBridge(ref)
+	if err != nil {
+		return mihomo.ObservedBridge{}, err
+	}
+	if r.gate == nil || r.gate.base == nil {
+		return mihomo.ObservedBridge{}, fmt.Errorf("%w: bridge registrar is nil", mihomo.ErrForeignBridgeOwnership)
+	}
+	proxyIdx := resolveProxyIndex(ref)
+	desc, exists, err := r.gate.LookupProxy(ctx, proxyIdx)
+	if err != nil {
+		return mihomo.ObservedBridge{}, fmt.Errorf("lookup proxy %d: %w", proxyIdx, err)
+	}
+	if !exists {
+		return mihomo.ObservedBridge{BridgeRef: ref, Exists: false}, nil
+	}
+
+	obs := mihomo.ObservedBridge{
+		BridgeRef: ref,
+		Exists:    true,
+		Up:        true,
+	}
+
+	// Mutually exclusive ownership classification:
+	if desc == "" {
+		// Empty description in NDMS means unmanaged interface
+		obs.OwnerUUID = ""
+		obs.LegacyOwner = ""
+	} else if desc == canonicalOwner {
+		// Proven canonical owner
+		obs.OwnerUUID = desc
+		obs.LegacyOwner = ""
+	} else if isAllowedLegacyOwner(desc, legacyOwners) {
+		// Proven legacy owner
+		obs.OwnerUUID = ""
+		obs.LegacyOwner = desc
+	} else {
+		// Any other non-empty description is foreign
+		obs.OwnerUUID = desc
+		obs.LegacyOwner = ""
+	}
+
+	return obs, nil
+}
+
+// PublishBridge creates/updates a bridge interface in NDMS ensuring exact ownership by AWGM.
+func (r *mihomoBridgeRuntime) PublishBridge(ctx context.Context, ref mihomo.BridgeRef) error {
+	canonicalOwner, legacyOwners, listenPort, err := r.resolveOwnedBridge(ref)
+	if err != nil {
+		return err
+	}
+	if r.gate == nil || r.gate.base == nil {
+		return fmt.Errorf("%w: bridge registrar is nil", mihomo.ErrForeignBridgeOwnership)
+	}
+	proxyIdx := resolveProxyIndex(ref)
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	r.gate.setReady(true)
+	owned, err := r.gate.EnsureProxyIfOwned(ctx, proxyIdx, listenPort, canonicalOwner, legacyOwners...)
+	if err != nil {
+		return fmt.Errorf("publish bridge Proxy%d: %w", proxyIdx, err)
+	}
+	if !owned {
+		return fmt.Errorf("%w: Proxy%d is owned by another entity", mihomo.ErrForeignBridgeOwnership, proxyIdx)
+	}
+	return nil
+}
+
+// WithdrawBridge tears down a bridge interface in NDMS only if proven owned by AWGM.
+func (r *mihomoBridgeRuntime) WithdrawBridge(ctx context.Context, ref mihomo.BridgeRef) error {
+	canonicalOwner, legacyOwners, _, err := r.resolveOwnedBridge(ref)
+	if err != nil {
+		return err
+	}
+	if r.gate == nil || r.gate.base == nil {
+		return fmt.Errorf("%w: bridge registrar is nil", mihomo.ErrForeignBridgeOwnership)
+	}
+	proxyIdx := resolveProxyIndex(ref)
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	removed, err := r.gate.RemoveProxyIfOwned(ctx, proxyIdx, canonicalOwner, legacyOwners...)
+	if err != nil {
+		return fmt.Errorf("withdraw bridge Proxy%d: %w", proxyIdx, err)
+	}
+	if !removed {
+		return fmt.Errorf("%w: refusing to withdraw unowned bridge Proxy%d", mihomo.ErrForeignBridgeOwnership, proxyIdx)
+	}
+	return nil
+}
+
+// ListObservedBridges inspects all active bridges from the native store.
+func (r *mihomoBridgeRuntime) ListObservedBridges(ctx context.Context) ([]mihomo.ObservedBridge, error) {
+	if r == nil || r.store == nil {
+		return nil, nil
+	}
+	active, err := r.ListActiveBridges(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var out []mihomo.ObservedBridge
+	for _, ref := range active {
+		obs, err := r.InspectBridge(ctx, ref)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, obs)
+	}
+	return out, nil
+}
 
