+func (v *NonLinuxProcessVerifier) VerifyIdentity(procDir string, pid int, expectedProcTicks uint64, expectedBinary, expectedConfigDir string) error {
+	if pid <= 0 {
+		return fmt.Errorf("%w: invalid pid %d", ErrProcessProofFailed, pid)
