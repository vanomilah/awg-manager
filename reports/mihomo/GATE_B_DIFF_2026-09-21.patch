+// enrichBridgeRefLocked enriches a legacy BridgeRef that lacks an OwnerUUID
+// by uniquely mapping it against the authoritative native store.
+// If the bridge is unmapped or ambiguous, it fails closed without guessing.
+func (c *ApplyCoordinator) enrichBridgeRefLocked(ref BridgeRef) (BridgeRef, error) {
+	if ref.OwnerUUID != "" {
+		return ref, nil
+	}
+	if c.cfg.StoreTx == nil {
+		return BridgeRef{}, fmt.Errorf("%w: cannot enrich legacy bridge %s (Proxy%d): store is nil", ErrForeignBridgeOwnership, ref.KernelInterface, ref.ProxyIndex)
+	}
+	nativeBridges := c.cfg.StoreTx.ListBridges()
+	var matched []BridgeRef
+	for _, nb := range nativeBridges {
+		if nb.ProxyIndex != ref.ProxyIndex {
+			continue
+		}
+		if ref.ProxyInterface != "" && nb.ProxyInterface != ref.ProxyInterface {
+			continue
+		}
+		if ref.KernelInterface != "" && nb.KernelInterface != ref.KernelInterface {
+			continue
+		}
+		matched = append(matched, nb)
+	}
+	if len(matched) == 0 {
+		return BridgeRef{}, fmt.Errorf("%w: legacy bridge %s (Proxy%d) has no store mapping for ownership enrichment", ErrForeignBridgeOwnership, ref.KernelInterface, ref.ProxyIndex)
+	}
+	if len(matched) > 1 {
+		return BridgeRef{}, fmt.Errorf("%w: legacy bridge %s (Proxy%d) has ambiguous (%d) store mappings for ownership enrichment", ErrForeignBridgeOwnership, ref.KernelInterface, ref.ProxyIndex, len(matched))
+	}
+	m := matched[0]
+	if m.OwnerUUID == "" {
+		return BridgeRef{}, fmt.Errorf("%w: store mapping for legacy bridge %s (Proxy%d) has empty OwnerUUID", ErrForeignBridgeOwnership, ref.KernelInterface, ref.ProxyIndex)
+	}
+	enriched := ref
+	enriched.OwnerUUID = m.OwnerUUID
+	if enriched.LegacyOwner == "" && m.LegacyOwner != "" {
+		enriched.LegacyOwner = m.LegacyOwner
+	}
+	return enriched, nil
+}
