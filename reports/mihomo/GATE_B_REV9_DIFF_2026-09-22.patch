+			r.durableMu.RUnlock()
+
+			mismatch := ref.ProxyIndex != storeRef.ProxyIndex ||
+				ref.ProxyInterface != storeRef.ProxyInterface ||
+				ref.KernelInterface != storeRef.KernelInterface ||
