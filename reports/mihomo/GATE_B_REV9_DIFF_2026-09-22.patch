+func (r BridgeRef) SlotKey() string {
+	if r.ProxyIndex > 0 && r.ProxyInterface != "" && r.KernelInterface != "" {
+		return fmt.Sprintf("%d:%s:%s", r.ProxyIndex, r.ProxyInterface, r.KernelInterface)
+	}
