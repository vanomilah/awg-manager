+		found := false
+		for _, s := range rec.Sources {
+			if s == source {
+				found = true
+				break
+			}
+		}
+		if !found {
+			rec.Sources = append(rec.Sources, source)
+			sort.Strings(rec.Sources)
+		}
+		if rec.Source == "" {
+			rec.Source = source
+		}
+	}
+
