+	b := upgradedRec.AppliedBridges[0]
+	if b.ProxyIndex != 1 || b.ProxyInterface != "Proxy1" || b.KernelInterface != "awg-br0" || b.ListenPort != 1080 || b.OwnerUUID != "uuid-owner-1" {
+		t.Fatalf("upgraded bridge is not complete: %+v", b)
