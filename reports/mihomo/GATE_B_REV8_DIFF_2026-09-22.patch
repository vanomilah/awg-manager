+func newGateBTestCluster(t *testing.T) *gateBTestCluster {
+	dir := t.TempDir()
+	store, err := mihomonative.NewStore(filepath.Join(dir, "native.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ndms := newFakeNDMSRegistrarWithOwnership()
