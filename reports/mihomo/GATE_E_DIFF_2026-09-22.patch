+			Slot:            orchestrator.SlotDeviceProxy,
+			PreviousEnabled: true,
+			Reason:          CompatibilityParkingReasonConflict,
+			Owner:           CompatibilityParkingOwner,
+			ParkedAt:        time.Now().UTC(),
+			ConfigDigest:    digest,
+			ConflictPort:    conflictPort,
+		}
