#!/bin/sh

# NOTE: opkg (unlike dpkg) invokes postinst as `postinst configure` with no
# version argument — there is no way to distinguish upgrade from fresh
# install here. Upgrade detection via "$2" never worked; the unified message
# below covers both cases.

# Create directories. /var/run is system tmpfs (always present) and
# is the new PID-file location since the migration off persistent
# /opt/var/run; explicit mkdir is defensive against unusual mount layouts.
mkdir -p /opt/etc/awg-manager/tunnels
mkdir -p /var/run
mkdir -p /opt/var/log

# Set permissions
chmod 755 /opt/bin/awg-manager
chmod 755 /opt/sbin/awg
chmod 755 /opt/etc/init.d/S99awg-manager
for script in S95tproxy-server S99telemt S96telemt-raw; do
    target="/opt/etc/init.d/$script"
    if [ -f "$target" ]; then
        chmod 755 "$target"
        saved_enabled="/tmp/.awgm_${script}_enabled"
        if [ -f "$saved_enabled" ]; then
            new_val=$(cat "$saved_enabled" 2>/dev/null)
            if [ -n "$new_val" ]; then
                sed -i "s/^ENABLED=.*/$new_val/" "$target" 2>/dev/null || true
            fi
            rm -f "$saved_enabled" 2>/dev/null || true
        fi
    fi
done
for hook in iflayerchanged ifcreated ifdestroyed ifipchanged; do
    chmod 755 "/opt/etc/ndm/${hook}.d/50-awg-manager.sh" 2>/dev/null || true
done

# Companion migration and symlinks
chmod 755 /opt/etc/awg-manager/susanin/bin/susanin-agent 2>/dev/null || true
chmod 755 /opt/etc/awg-manager/telemt/telemt 2>/dev/null || true
chmod 755 /opt/etc/awg-manager/mihomo/mihomo 2>/dev/null || true

# Migrate legacy directories to symlinks if they are standalone directories
if [ -d /opt/etc/telemt ] && [ ! -L /opt/etc/telemt ]; then
    mkdir -p /opt/etc/awg-manager/telemt
    cp -a /opt/etc/telemt/* /opt/etc/awg-manager/telemt/ 2>/dev/null || true
    rm -rf /opt/etc/telemt
fi
if [ -d /opt/susanin ] && [ ! -L /opt/susanin ]; then
    mkdir -p /opt/etc/awg-manager/susanin
    cp -a /opt/susanin/* /opt/etc/awg-manager/susanin/ 2>/dev/null || true
    rm -rf /opt/susanin
fi

if [ -f /opt/etc/awg-manager/susanin/bin/susanin-agent ]; then
    chmod 755 /opt/etc/awg-manager/susanin/bin/susanin-agent
    rm -f /opt/bin/susanin-agent
    ln -sf /opt/etc/awg-manager/susanin/bin/susanin-agent /opt/bin/susanin-agent
    [ ! -e /opt/susanin ] && ln -sf /opt/etc/awg-manager/susanin /opt/susanin
fi
if [ -f /opt/etc/awg-manager/telemt/telemt ]; then
    chmod 755 /opt/etc/awg-manager/telemt/telemt
    rm -f /opt/bin/telemt
    ln -sf /opt/etc/awg-manager/telemt/telemt /opt/bin/telemt
    [ ! -e /opt/etc/telemt ] && ln -sf /opt/etc/awg-manager/telemt /opt/etc/telemt
fi
if [ -f /opt/etc/awg-manager/mihomo/mihomo ]; then
    chmod 755 /opt/etc/awg-manager/mihomo/mihomo
    rm -f /opt/bin/mihomo
    ln -sf /opt/etc/awg-manager/mihomo/mihomo /opt/bin/mihomo
fi

# Persistent DNAT hook for tproxy-server (8085)
mkdir -p /opt/etc/ndm/netfilter.d
cat << 'EOF' > /opt/etc/ndm/netfilter.d/64-awgm-tproxy-dnat.sh
#!/bin/sh
# AWG Manager: DNAT for tproxy-server (8085) to loopback
[ "$type" = "ip6tables" ] && exit 0
sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null 2>&1
sysctl -w net.ipv4.conf.default.route_localnet=1 >/dev/null 2>&1
for iface in /proc/sys/net/ipv4/conf/*; do
    [ -f "$iface/route_localnet" ] && echo 1 > "$iface/route_localnet" 2>/dev/null
done

IPTABLES=/opt/sbin/iptables
[ -x "$IPTABLES" ] || IPTABLES=iptables
run() { "$IPTABLES" -w "$@" 2>/dev/null || "$IPTABLES" "$@" 2>/dev/null; }

if [ "$table" = "filter" ] || [ -z "$table" ]; then
    run -C INPUT -p tcp --dport 8085 -j ACCEPT 2>/dev/null || run -I INPUT 1 -p tcp --dport 8085 -j ACCEPT
fi

if [ "$table" = "nat" ] || [ -z "$table" ]; then
    run -t nat -C PREROUTING -p tcp --dport 8085 -j DNAT --to-destination 127.0.0.1:8085 2>/dev/null || \
    run -t nat -I PREROUTING 1 -p tcp --dport 8085 -j DNAT --to-destination 127.0.0.1:8085

    run -t nat -C OUTPUT -p tcp -o lo -d 127.0.0.1 --dport 8085 -j ACCEPT 2>/dev/null || \
    run -t nat -I OUTPUT 1 -p tcp -o lo -d 127.0.0.1 --dport 8085 -j ACCEPT

    run -t nat -C OUTPUT -p tcp --dport 8085 -j DNAT --to-destination 127.0.0.1:8085 2>/dev/null || \
    run -t nat -A OUTPUT -p tcp --dport 8085 -j DNAT --to-destination 127.0.0.1:8085
fi
exit 0
EOF
chmod 755 /opt/etc/ndm/netfilter.d/64-awgm-tproxy-dnat.sh
/opt/etc/ndm/netfilter.d/64-awgm-tproxy-dnat.sh 2>/dev/null || true

# Ensure Keenetic HTTP proxy preserves Host header for tproxy-server (8085)
if command -v ndmq >/dev/null 2>&1; then
    ndmq -p "ip http proxy tg preserve-host" -x >/dev/null 2>&1 || true
    ndmq -p "system configuration save" -x >/dev/null 2>&1 || true
fi

# Clean up legacy files
rm -f /opt/etc/ndm/ifstatechanged.d/50-awg-manager.sh
rm -f /opt/var/log/awg-wan-hook.log
rm -f /opt/etc/init.d/S80awg-manager
rm -rf /opt/lib/modules/awg_proxy
rm -rf /opt/share/www/awg-manager
# Замок и лог stderr переехали на tmpfs, PID — раньше; старые места на
# накопителе (#854). Демон на этот момент остановлен prerm'ом.
rm -rf /opt/var/lock/awg-manager /opt/var/run/awg-manager
rm -f /opt/tmp/awg-manager-upgrade.log /opt/tmp/awg-manager-stderr.log

# Start awg-manager
START_OK=1
/opt/etc/init.d/S99awg-manager start || START_OK=0

# Wait a moment for settings to be initialized
sleep 2

# Get the port from settings.json (daemon persists actual port there).
# sed extracts the first "port": N match; the old `grep | tr -cd 0-9`
# concatenated digits from every matching line and broke on minified JSON.
PORT=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
    /opt/etc/awg-manager/settings.json 2>/dev/null | head -n 1)
[ -z "$PORT" ] && PORT="2222"

# Get LAN IP from br0 interface (Keenetic bridge) - for display to user
ROUTER_IP=""
if command -v ip >/dev/null 2>&1; then
    # Get IP from br0 (LAN bridge)
    ROUTER_IP=$(ip -4 addr show br0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')
fi
if [ -z "$ROUTER_IP" ] && command -v ifconfig >/dev/null 2>&1; then
    # Fallback to ifconfig
    ROUTER_IP=$(ifconfig br0 2>/dev/null | grep -oE 'inet (addr:)?[0-9.]+' | grep -oE '[0-9.]+')
fi
if [ -z "$ROUTER_IP" ]; then
    ROUTER_IP="<ROUTER-IP>"
fi

echo ""
if [ "$START_OK" = "1" ]; then
    echo "=========================================="
    echo "  AWG Manager installed successfully!"
    echo "=========================================="
    echo ""
    echo "  Web UI: http://${ROUTER_IP}:${PORT}"
else
    echo "=========================================="
    echo "  AWG Manager installed, but the service"
    echo "  FAILED to start. Check the log and run:"
    echo "    /opt/etc/init.d/S99awg-manager start"
    echo "=========================================="
fi
echo ""
echo "  Commands:"
echo "    /opt/etc/init.d/S99awg-manager {start|stop|restart|status}"
echo ""
