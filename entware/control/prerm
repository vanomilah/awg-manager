#!/bin/sh

ACTION="$1"
INIT_DIR="${AWGM_INIT_DIR:-/opt/etc/init.d}"
MANIFEST_DIR="${AWGM_MANIFEST_DIR:-/opt/etc/awg-manager}"
MANIFEST="$MANIFEST_DIR/.unmanaged_inits.manifest"

# On upgrade: only stop awg-manager daemon, keep tunnels running
if [ "$ACTION" = "upgrade" ]; then
    echo "Upgrading awg-manager..."
    echo "  Tunnels will continue running during upgrade."
    "$INIT_DIR/S99awg-manager" stop 2>/dev/null || true
    exit 0
fi

# On remove: use awg-manager's own cleanup to properly delete tunnels
echo "Removing awg-manager..."

# Stop the daemon first (if running)
"$INIT_DIR/S99awg-manager" stop 2>/dev/null || true

# Stop and remove managed worker init scripts (only if MANAGED_BY=awg-manager)
for script in S95tproxy-server S99telemt S96telemt-raw; do
    target="$INIT_DIR/$script"
    if [ -f "$target" ]; then
        if grep -q "MANAGED_BY=awg-manager" "$target" 2>/dev/null; then
            "$target" stop 2>/dev/null || true
            rm -f "$target"
        fi
    fi
done

# Restore unmanaged init scripts if backed up during installation
if [ -f "$MANIFEST" ] && [ ! -L "$MANIFEST" ]; then
    echo "Checking for unmanaged init scripts to restore..."
    NEW_MANIFEST="${MANIFEST}.tmp.$$"
    rm -f "$NEW_MANIFEST" 2>/dev/null || true

    while IFS=" " read -r script sha || [ -n "$script" ]; do
        [ -z "$script" ] && continue
        case "$script" in
            S95tproxy-server|S99telemt|S96telemt-raw) ;;
            *)
                echo "$script $sha" >> "$NEW_MANIFEST"
                continue
                ;;
        esac
        target="$INIT_DIR/$script"
        bak="${target}.bak"
        if [ -f "$bak" ] && [ ! -L "$bak" ]; then
            # Verify checksum against recorded SHA-256 if available
            if [ -n "$sha" ] && command -v sha256sum >/dev/null 2>&1; then
                cur_sha=$(sha256sum "$bak" 2>/dev/null | awk '{print $1}')
                if [ -n "$cur_sha" ] && [ "$cur_sha" != "$sha" ]; then
                    echo "Warning: checksum mismatch for $bak (expected $sha, got $cur_sha) - preserving backup"
                    echo "$script $sha" >> "$NEW_MANIFEST"
                    continue
                fi
            fi

            if [ ! -e "$target" ] || grep -q "MANAGED_BY=awg-manager" "$target" 2>/dev/null; then
                echo "Restoring unmanaged $bak to $target..."
                tmp_target="${target}.tmp.$$"
                if cp -p "$bak" "$tmp_target" 2>/dev/null || cp "$bak" "$tmp_target" 2>/dev/null; then
                    chmod 0755 "$tmp_target" 2>/dev/null || true
                    if mv -f "$tmp_target" "$target" 2>/dev/null; then
                        rm -f "$bak" 2>/dev/null || true
                    else
                        rm -f "$tmp_target" 2>/dev/null || true
                        echo "Warning: failed to move restored script to $target"
                        echo "$script $sha" >> "$NEW_MANIFEST"
                    fi
                else
                    echo "Warning: failed to restore $bak to $target"
                    echo "$script $sha" >> "$NEW_MANIFEST"
                fi
            else
                # Target exists and is not managed by awg-manager
                echo "$script $sha" >> "$NEW_MANIFEST"
            fi
        else
            # Backup does not exist
            echo "Warning: backup file $bak missing"
        fi
    done < "$MANIFEST"

    if [ -s "$NEW_MANIFEST" ]; then
        mv -f "$NEW_MANIFEST" "$MANIFEST" 2>/dev/null || true
        echo "Notice: some unmanaged init scripts were preserved in $MANIFEST for manual review."
    else
        rm -f "$NEW_MANIFEST" "$MANIFEST" 2>/dev/null || true
    fi
fi


# Хук перехвата DNS policy-tun переживает удаление пакета и продолжает
# реассертить DNAT в туннель, которого больше нет: правила зашиты прямо в
# него самого, без внешнего файла-гейта, поэтому no-op'ом после удаления не
# становится. Снимаем ЯВНО, вместе с правилами.
# Идёт ПОСЛЕ остановки демона: живой демон вернул бы их на ближайшей сверке.
POLICYTUN_HOOK=/opt/etc/ndm/netfilter.d/52-awgm-policytun-dns.sh
if [ -f "$POLICYTUN_HOOK" ]; then
    echo "Removing policy-tun DNS hook..."
    rm -f "$POLICYTUN_HOOK"
fi
# Тот же перехват режима fakeip (свой тег) — без него у клиентов сегментов с
# заворотом DNS уходил бы на адрес удалённого туннеля до перезагрузки (F450).
if [ -x /opt/sbin/iptables ]; then
    /opt/sbin/iptables -w -t nat -S PREROUTING 2>/dev/null \
        | grep -E -- 'AWGM-POLICYTUN-DNS|AWGM-FAKEIP-INGRESS' \
        | sed 's/-A PREROUTING/-D PREROUTING/' \
        | tr -d '"' \
        | while IFS= read -r line; do /opt/sbin/iptables -w -t nat $line 2>/dev/null; done
fi

# Маршрутная половина заворота (ip rule iif … lookup 700, таблица 700) —
# internal/singbox/router/fakeip_ingress.go, fakeIPIngressTable.
if [ -x /opt/sbin/ip ]; then
    i=0
    while [ $i -lt 64 ] && /opt/sbin/ip rule del table 700 2>/dev/null; do i=$((i+1)); done
    /opt/sbin/ip route flush table 700 2>/dev/null || true
fi

# Хук туннельного firewall (static-NAT на все ip global выходы) гейтится
# файлом-списком, но сам файл переживает удаление пакета — снимаем оба.
rm -f /opt/etc/ndm/netfilter.d/51-awgm-tunnel-fw.sh /opt/etc/awg-manager/tunnel-fw.list

# Остальные наши хуки (#854): 50-awgm-tproxy.sh код не удаляет никогда (после
# снятия файла правил он no-op), 61/62 снимает только живая фича. Все они
# именуются NN-awgm-*.sh — подметаем разом.
rm -f /opt/etc/ndm/netfilter.d/*-awgm-*.sh

# Каталоги лока и старого PID, логи и недокачанный IPK на накопителе (#854).
rm -rf /opt/var/lock/awg-manager /opt/var/run/awg-manager
rm -f /opt/tmp/awg-manager-upgrade.log /opt/tmp/awg-manager-stderr.log /opt/tmp/awg-manager_*.ipk

echo ""
echo "=============================================="
echo "  awg-manager has been removed."
echo ""
echo "  Settings and data preserved at:"
echo "    /opt/etc/awg-manager"
echo ""
echo "  Full removal (data, repo file):"
echo "    https://hoaxisr.github.io/awg-manager-docs/install/#полное-удаление"
echo "=============================================="
echo ""
