#!/bin/sh
# Pre-install script for awg-manager
# Preserves unmanaged init scripts and ENABLED flags before unpacking new files

MANIFEST_DIR="${AWGM_MANIFEST_DIR:-/opt/etc/awg-manager}"
MANIFEST="$MANIFEST_DIR/.unmanaged_inits.manifest"
INIT_DIR="${AWGM_INIT_DIR:-/opt/etc/init.d}"
TMP_DIR="${AWGM_TMP_DIR:-/tmp}"

mkdir -p "$MANIFEST_DIR" 2>/dev/null || true

for script in S95tproxy-server S99telemt S96telemt-raw; do
    target="$INIT_DIR/$script"
    if [ -f "$target" ] && [ ! -L "$target" ]; then
        # If existing script is not managed by awg-manager, back it up to .bak
        if ! grep -q "MANAGED_BY=awg-manager" "$target" 2>/dev/null; then
            bak="${target}.bak"
            # Never overwrite an existing .bak during upgrade
            if [ ! -e "$bak" ] && [ ! -L "$bak" ]; then
                echo "Backing up unmanaged $target to $bak"
                sha=""
                if command -v sha256sum >/dev/null 2>&1; then
                    sha=$(sha256sum "$target" 2>/dev/null | awk '{print $1}')
                fi
                if cp -p "$target" "$bak" 2>/dev/null || cp "$target" "$bak" 2>/dev/null; then
                    echo "$script $sha" >> "$MANIFEST"
                else
                    echo "Warning: failed to backup unmanaged $target to $bak" >&2
                fi
            fi
        fi

        # Extract ENABLED setting from existing file so postinst can preserve it
        enabled_val=$(grep '^ENABLED=' "$target" 2>/dev/null | head -n 1)
        if [ -n "$enabled_val" ]; then
            echo "$enabled_val" > "$TMP_DIR/.awgm_${script}_enabled" 2>/dev/null || true
        fi
    fi
done

exit 0
